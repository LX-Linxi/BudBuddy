.quick-card {
  width: 100%;

  background: var(--color-card);

  border-radius: var(--radius-md);

  padding: 20rpx 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  box-sizing: border-box;
}

.quick-icon {
  font-size: 36rpx;
}

.quick-name {
  margin-top: 8rpx;

  font-size: 26rpx;

  color: var(--color-text);
} 