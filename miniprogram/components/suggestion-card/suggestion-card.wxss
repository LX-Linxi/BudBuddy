.suggestion-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.suggestion-header {
  display: flex;
  align-items: center;
}

.suggestion-icon {
  font-size: 40rpx;
}

.suggestion-title {
  margin-left: 16rpx;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text);
}

.suggestion-content {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}