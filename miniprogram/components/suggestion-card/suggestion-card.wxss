.suggestion-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.suggestion-header {
  display: flex;
  align-items: center;
}

.suggestion-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.suggestion-title {
  margin-left: 12rpx;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text);
}

.suggestion-content {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.6;
}