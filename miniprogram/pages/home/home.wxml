<view class="page">

  <!-- 宝宝信息卡片 -->
  <view class="baby-card">

    <view class="avatar">
      👶
    </view>

    <view class="baby-info">

      <text class="baby-name">
        {{baby.nickname}}
      </text>

      <text class="baby-age">
        {{baby.age}}
      </text>

      <text class="baby-days">
        成长第 {{baby.growthDays}} 天
      </text>

    </view>

  </view>
  <!-- 今日成长建议 -->
<view class="section">

  <text class="section-title">
    ✨ 今日成长建议
  </text>


  <view 
    class="suggestion-card"
    wx:for="{{suggestions}}"
    wx:key="id"
  >

    <view class="suggestion-header">

      <text class="suggestion-icon">
        {{item.icon}}
      </text>

      <text class="suggestion-title">
        {{item.title}}
      </text>

    </view>


    <text class="suggestion-content">
      {{item.content}}
    </text>


  </view>


</view>
<!-- 快捷入口 -->
<view class="section">

  <text class="section-title">
    🚀 快捷入口
  </text>


  <view class="quick-grid">


    <view
      class="quick-card"
      wx:for="{{quickEntries}}"
      wx:key="name"
    >

      <text class="quick-icon">
        {{item.icon}}
      </text>


      <text class="quick-name">
        {{item.name}}
      </text>


    </view>


  </view>

</view>

</view>
