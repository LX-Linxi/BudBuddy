<view class="page">

<!-- 宝宝信息卡片 -->
<baby-card baby="{{baby}}" />


<!-- 今日成长建议 -->
<view class="section">

  <text class="section-title">
    ✨ 今日成长建议
  </text>

  <suggestion-card
    wx:for="{{suggestions}}"
    wx:key="id"
    suggestion="{{item}}"
  />

</view>


<!-- 快捷入口 -->
<view class="section">

  <text class="section-title">
    🚀 快捷入口
  </text>

  <view class="quick-grid">

    <view
      class="quick-entry-wrapper"
      wx:for="{{quickEntries}}"
      wx:key="name"
    >
      <quick-entry entry="{{item}}" />
    </view>

  </view>

</view>
</view>