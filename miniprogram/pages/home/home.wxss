.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 32rpx;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}


.baby-card {

  background: var(--color-card);

  border-radius: var(--radius-md);

  padding: var(--spacing-md);

  display: flex;

  align-items: center;

}


.avatar {

  width: 100rpx;

  height: 100rpx;

  border-radius: 50%;

  background: var(--color-primary-light);

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 48rpx;

}


.baby-info {

  margin-left: 24rpx;

  display: flex;

  flex-direction: column;

}


.baby-name {

  font-size: var(--font-title);

  font-weight: bold;

  color: var(--color-text);

}


.baby-age {

  margin-top: 12rpx;

  font-size: var(--font-body);

  color: var(--color-text-secondary);

}


.baby-days {

  margin-top: 8rpx;

  font-size: var(--font-caption);

  color: var(--color-text-placeholder);

}
/* =====================
   今日成长建议
===================== */


.section {

  margin-top: 32rpx;

}


.section-title {

  display: block;

  font-size: var(--font-subtitle);

  font-weight: bold;

  color: var(--color-text);

  margin-bottom: 20rpx;

}



.suggestion-card {


  background: var(--color-card);


  border-radius: var(--radius-md);


  padding: 24rpx;

  margin-bottom: 20rpx;


}



/* 图标 + 标题 */
.suggestion-header {


  display: flex;


  align-items: center;


}



.suggestion-icon {


  font-size: 40rpx;


}



.suggestion-title {


  margin-left: 16rpx;


  font-size: var(--font-body);


  font-weight: 600;


  color: var(--color-text);


}



.suggestion-content {


  display: block;


  margin-top: 16rpx;


  font-size: var(--font-caption);


  color: var(--color-text-secondary);


}
/* =====================
   快捷入口
===================== */

.quick-grid {

  display:flex;

  flex-wrap:wrap;

  justify-content:space-between;

}


.quick-card {

  width:48%;

  background:var(--color-card);

  border-radius:var(--radius-md);

  padding:20rpx 0;

  margin-bottom:16rpx;

  display:flex;

  flex-direction:column;

  align-items:center;

}


.quick-icon {

  font-size:36rpx;

}


.quick-name {

  margin-top:8rpx;

  font-size:26rpx;

  color:var(--color-text);

}