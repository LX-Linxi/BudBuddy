.page {
  min-height: 100vh;
  background: var(--background-color);
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card-color);
  border-radius: var(--radius-medium);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}
