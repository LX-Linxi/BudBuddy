
.page {
  min-height: 100%;
  background: var(--color-bg);

  box-sizing: border-box;

  padding:
    var(--spacing-lg)
    var(--spacing-lg)
    calc(
      var(--spacing-lg)
      + env(safe-area-inset-bottom)
    );
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
}

.subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
