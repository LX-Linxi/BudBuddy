.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
}

.subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
